<main class="container page-main">
  <div class="content-layout">
    <div class="content-main">
      <article class="post">
        <div class="post-path mono">
          <span class="t-prompt">~/pages</span><span class="path-sep">/</span><span class="path-file"><%- page.slug %>.md</span>
        </div>
        <header class="post-header">
          <h1 class="post-title-lg"><%- page.title %></h1>
          <div class="post-meta mono"><span class="meta-item">更新于 <%- date(page.updated, 'YYYY/M/D') %></span></div>
        </header>
        <div class="post-content">
          <%- page.content %>
        </div>
      </article>
    </div>
    <%- partial('_partial/sidebar') %>
  </div>
</main>
