<header class="site-header">
  <div class="container nav-wrap">
    <a class="logo" href="<%- url_for('/') %>" aria-label="首页">
      <span class="logo-mark">~/</span><span class="logo-name"><%- theme.site.name %></span><span class="logo-cursor"></span>
    </a>

    <nav class="nav-links" id="nav-links">
      <%
        var currentPath = page.path || '';
        Object.keys(theme.menu).forEach(function (name) {
          var href = theme.menu[name];
          var target = url_for(href);
          var active = currentPath === href.replace(/^\//, '') || (href !== '/' && currentPath.indexOf(href.replace(/^\//, '')) === 0);
      %>
        <a href="<%- target %>" class="nav-link<%- active ? ' active' : '' %>"><%- name %></a>
      <% }); %>
    </nav>

    <div class="nav-actions">
      <button class="icon-btn" id="search-toggle" type="button" aria-label="搜索" title="搜索 ( / )">
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        <span class="search-hint">搜索</span>
      </button>
      <button class="icon-btn" id="theme-toggle" type="button" aria-label="切换主题" title="切换深色/浅色">
        <svg class="icon-sun" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
        <svg class="icon-moon" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
      </button>
    </div>
  </div>
</header>

<!-- 搜索弹层 -->
<div class="search-modal" id="search-modal" hidden>
  <div class="search-modal-backdrop" data-search-close></div>
  <div class="search-panel" role="dialog" aria-modal="true" aria-label="站内搜索">
    <div class="search-input-row">
      <span class="search-prompt">$</span>
      <input id="search-input" class="search-input" type="text" placeholder="grep 文章标题 / 正文..." autocomplete="off" spellcheck="false">
      <kbd>ESC</kbd>
    </div>
    <div class="search-status" id="search-status">输入关键词开始搜索</div>
    <ul class="search-results" id="search-results"></ul>
  </div>
</div>
